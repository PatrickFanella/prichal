[Unit]
Description=Private SSH path to Dozor Prichal pilot ingress

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -T -o ControlMaster=no -o ControlPath=none -o BatchMode=yes -o StrictHostKeyChecking=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -L 172.20.0.1:34943:127.0.0.1:45624 dozor
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
