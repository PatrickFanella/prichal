[Unit]
Description=Restricted fresh Kvant public staging PDS agent
After=docker.service
Requires=docker.service

[Service]
User=prichal-agent
Group=prichal-agent
SupplementaryGroups=docker
EnvironmentFile=/etc/prichal-public-pds/agent.env
ExecStart=/usr/local/libexec/prichal-public-pds/node-agent
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/prichal-public-pds
MemoryMax=128M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
