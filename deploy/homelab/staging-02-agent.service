[Unit]
Description=Prichal private staging qualification agent
After=docker.service
Requires=docker.service

[Service]
User=prichal-agent
Group=prichal-agent
SupplementaryGroups=docker
Environment=PDS_MODE=production
Environment=PDS_STAGING_PROVISIONING=true
Environment=PDS_AGENT_LISTEN=127.0.0.1:9091
Environment=PDS_AGENT_DOCKER_SOCKET=/var/run/docker.sock
Environment=PDS_AGENT_STATE_DIRECTORY=/var/lib/prichal-agent/state
Environment=PDS_AGENT_CA_FILE=/var/lib/prichal-agent/ca.crt
Environment=PDS_AGENT_CERT_FILE=/var/lib/prichal-agent/enrolled/node.crt
Environment=PDS_AGENT_KEY_FILE=/var/lib/prichal-agent/enrolled/node.key
Environment=PDS_AGENT_MAXIMUM_SLOTS=1
ExecStart=/usr/local/libexec/prichal/node-agent
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/prichal-agent

[Install]
WantedBy=multi-user.target
